#ifndef BITMAPS
	#define BITMAPS

	//bitmapped font characters
    //15 bits each, 3 wide, 5 tall
	//they are mirrored here in memory when viewed directly because they are
    //read low to high bits as bottom left to top right in scanline order 

	#define BITMAP_NUMBERS
	#define BITMAP_LETTERS
	#define BITMAP_SYMBOLS

	#ifdef BITMAP_NUMBERS
		#define BITMAP_NUMBERS
		#define _0 			0x00007B6F
		#define _1 			0x00004D24
		#define _2 			0x0000788F
		#define _3 			0x000079E7
		#define _4 			0x00005BE4
		#define _5 			0x000073E7
		#define _6 			0x000073EF
		#define _7 			0x00007892
		#define _8 			0x00007BEF
		#define _9 			0x00007BE7
	#endif

	#ifdef BITMAP_LETTERS
		#define _A 			0x00007BED
		#define _B 			0x00007AEF
		#define _C 			0x00007A6F
		#define _D 			0x00003B6B
		#define _E 			0x000073CF
		#define _F 			0x000073C9
		#define _G 			0x00007BE7
		#define _H 			0x00005BED
		#define _I 			0x00007497
		#define _J 			0x0000492F
		#define _K 			0x0000565D
		#define _L 			0x0000124F
		#define _M 			0x00005F6D
		#define _N 			0x00003B6D
		#define _O 			0x00007B6F
		#define _P 			0x00007BC9
		#define _Q 			0x00007B7C
		#define _R 			0x00007AED
		#define _S 			0x000073E7
		#define _T 			0x00007492
		#define _U 			0x00005B6F
		#define _V 			0x00005B6A
		#define _W 			0x00005B7D
		#define _X 			0x00005AAD
		#define _Y 			0x00005A92
		#define _Z 			0x0000788F
	#endif

	#ifdef BITMAP_SYMBOLS
		#define _EQUALS 	0x00000E38
		#define _PLUS 		0x000005D0
		#define _MINUS 		0x000001C0
		#define _MUL 		0x00000AA8
		#define _MOD 		0x0000188C
		#define _AND 		0x000072EF
		#define _OR 		0x00002492
		#define _XOR 		0x00000568
		#define _NOT 		0x000006B0
		#define _PERIOD 	0x00000002
		#define _QUEST 		0x00007882
		#define _EXCL  		0x00002482
		#define _COLON 		0x00000410
		#define _SCOLON 	0x00000413
		#define _COMMA 		0x00000019
		#define _ULINE 		0x00000007
		#define _LSLASH 	0x000002A0
		#define _RSLASH 	0x00000888
		#define _LSHIFT 	0x00004454
		#define _RSHIFT 	0x00001511
		#define _LPAREN 	0x0000665E
		#define _RPAREN 	0x00003D33
		#define _LCURL	 	0x000064D6
		#define _RCURL 		0x00003593
		#define _LBRACKET 	0x00006496
		#define _RBRACKET 	0x00003493
		#define _SPACE 		0x00000000
	#endif
#endif

