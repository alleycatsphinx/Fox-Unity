#ifdef MAP_VIEW
float3 uv_to_ray(float2 uv) 
{
   	float3 direction = mul(CPU.rendering.projection.inverse, float4(uv * 2. - 1., 0., 1.0f)).xyz;
  	direction 		 = mul(CPU.rendering.projection.to_world, float4(direction, 0.0f)).xyz;  	
    return normalize(direction);
}


[numthreads(8, 8, 1)]
void View(uint2 thread : SV_DispatchThreadID)
{
	float4 position 			= _GeometryTarget[thread];
	
	uint2 resolution			= CPU.rendering.resolution; 
	uint e 						= 2.;//CPU.debug.h; //distance of samples
	float4 position0 			= _GeometryTarget[clamp(thread - uint2(e,0), uint2(0,0), resolution)];
	float4 position1 			= _GeometryTarget[clamp(thread - uint2(0,e), uint2(0,0), resolution)];
	float4 position2 			= _GeometryTarget[clamp(thread + uint2(e,0), uint2(0,0), resolution)];
	float4 position3 			= _GeometryTarget[clamp(thread + uint2(0,e), uint2(0,0), resolution)];
	
	
	float3 error 				= abs(position.xyz-position0.xyz)
								+ abs(position.xyz-position1.xyz)
								+ abs(position.xyz-position2.xyz)
								+ abs(position.xyz-position3.xyz);
	
	float tolerance 			= 0.025; CPU.debug.i; //
	bool similar 				= length(error) < tolerance;

	similar 					= dot(position, float3(1., 1., 1.)) != 0.;
	if(similar)
	{
		position 				= position
								+ position0
								+ position1
								+ position2
								+ position3;
		position 				*= .2;		

		float2 uv	 			= thread.xy * rcp(resolution);				
	   	float3 ray 	 			= uv_to_ray(uv);
	   	// float3 origin 			= mul(CPU.rendering.projection.to_world, float4(0.,0.,0.,1.)).xyz;

	   	float3 origin 			= mul(CPU.rendering.projection.to_world, CPU.rendering.projection.position).xyz;
		float3 direction 		= normalize(position.xyz - origin);

		bool aligned			= pow(dot(direction, ray), 16.) < .85; //.85 is suss - CPU.debug.j;
		
		if(aligned)
		{
			uint octave 		= OCTAVE_MAX;
			uint address 		= position_address_normed(position.xyz, octave);

			uint thread_address = address >> 6;
			uint2 bitmap		= load_64(thread_address, _Bitmap_Guassian_Low);
			bitmap 				|= write_64(bitmap, address % 64);			

			uint2 bitmap_high  	= load_64(thread_address, _Bitmap_Guassian_High);			

			if(any(bitmap || bitmap_high))
			{
				if(thread_address < 262144)
				{
					uint prior 		= 0;
					InterlockedOr(_Bitmap_Guassian_Low[thread_address].x, bitmap.x, prior);
					InterlockedOr(_Bitmap_Guassian_Low[thread_address].y, bitmap.y, prior);
				}	
			}
		}
	}
}
#else
[numthreads(1, 1, 1)]
void View(uint thread : SV_DispatchThreadID) { }
#endif


#ifdef MAP_CLEAR
//Clears all data in the buffer
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Clear(uint thread : SV_DispatchThreadID)
{		
	if(thread < Bitmap_Field_Low_COUNT)
	{
		store_64(thread, uint2(0x0000000, 0x0000000), _Bitmap_Low);
		store_64(thread, uint2(0x0000000, 0x0000000), _Bitmap_High);
	}

	if(thread < Bitmap_Field_Low_COUNT)
	{
		store_64(thread, uint2(0x0000000, 0x0000000), _Bitmap_Field_Low);
		store_64(thread, uint2(0x0000000, 0x0000000), _Bitmap_Field_High);
		store_64(thread, uint2(0x0000000, 0x0000000), _Bitmap_Tensor_Low);
		store_64(thread, uint2(0x0000000, 0x0000000), _Bitmap_Tensor_High);
		store_64(thread, uint2(0x0000000, 0x0000000), _Bitmap_Guassian_Low);
		store_64(thread, uint2(0x0000000, 0x0000000), _Bitmap_Guassian_High);
	}	
}
#else
[numthreads(1, 1, 1)]
void Clear(uint thread : SV_DispatchThreadID) { }
#endif



#ifdef MAP_COMBINE
//Combines all bitmaps to the main buffer
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Combine(uint thread : SV_DispatchThreadID)
{		
	//read bitmaps
	uint2 bitmap_low 	= _Bitmap_Field_Low[thread] | _Bitmap_Guassian_Low[thread] | _Bitmap_Tensor_Low[thread];

	uint2 bitmap_high 	= _Bitmap_Field_High[thread];

	uint prior;

	// InterlockedExchange(_Bitmap_Low[thread].x, bitmap_low.x, prior);
	// InterlockedExchange(_Bitmap_Low[thread].y, bitmap_low.y, prior);

	// InterlockedExchange(_Bitmap_High[thread].x, bitmap_high.x, prior);
	// InterlockedExchange(_Bitmap_High[thread].y, bitmap_high.y, prior);

	InterlockedOr(_Bitmap_Low[thread].x, bitmap_low.x, prior);
	InterlockedOr(_Bitmap_Low[thread].y, bitmap_low.y, prior);

	InterlockedOr(_Bitmap_High[thread].x, bitmap_high.x, prior);
	InterlockedOr(_Bitmap_High[thread].y, bitmap_high.y, prior);
}
#else
[numthreads(1, 1, 1)]
void Combine(uint thread : SV_DispatchThreadID) { }
#endif

