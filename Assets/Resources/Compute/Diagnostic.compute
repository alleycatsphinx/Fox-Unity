#ifdef DIAGNOSTIC_MESH
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Mesh(uint thread : SV_DispatchThreadID)
{			
	uint address 				= equidistribute_thread(thread);
	StructTensor tensor 		= _Tensor[address];
	StructEdge edge 			= _Edge[address];
	
	float3 position_local		= tensor.position.xyz;
	float3 position_neighbor	= float3(0., 0., 0.);

	float depth					= distance_to_view(tensor.position.xyz);						
	float scale 				= .0125 * rcp(depth);
	float limit 				=  2048;

	bool visible 				= in_frustrum(position_local);
	
	////DEBUG THREAD ADDRESS
	// float depth_prior 			= _ColorTarget[coordinate].w;	
	for(int i = 0; i < EDGE_COUNT; i++)
	{
		position_neighbor.xyz 	= _Tensor[edge.address[i]].position.xyz;
		float range 			= length(position_neighbor.xyz - position_local.xyz);
		
		bool bounded			= range < CPU.debug.n || CPU.debug.n < 0.;

		////Line to neighbor
		if(bounded && visible && in_frustrum(position_neighbor))// && range < .1)//CPU.sim.flock.threshold)
		{	
			float3 color		= 2. *  _Tensor[edge.address[i]].color.xyz * 1. * clamp(-depth*depth*depth, .04, 4.) * 2.25;
			// color 				+= dot(tensor.position, cross(float3(1., 1., 1.), position_neighbor.xyz)) * CPU.debug.h;
			float rate 			= abs(length(_Tensor[edge.address[i]].prior.xyz - _Tensor[edge.address[i]].position.xyz) - length(_Tensor[edge.address[i]].prior1.xyz - _Tensor[edge.address[i]].position.xyz));

			raster_line(position_local, position_neighbor, limit, float4(color, depth), _ColorTarget);								
			// raster_line(position_local, position_neighbor, limit, float4(rainbow(float(i+1) * rcp(12.)) * .125 * clamp(4.-depth*depth, .04, 4.) * .25, 1.) + .0125, _ColorTarget);							
		}	
	}
}
#else
[numthreads(1, 1, 1)]
void Mesh(uint thread : SV_DispatchThreadID) { }
#endif


#ifdef DIAGNOSTIC_COLLISION
[numthreads(1, 1, 1)]
void Collision(uint thread : SV_DispatchThreadID)
{			
	if(thread == 0)
	{
		 	
// GPU.field.collision.direction	

		float4 color 				= float4(1., 1., 1., 1.);
		float3 position 			= GPU.field.collision.position.xyz;
		float limit 				= 8192.;
		int2 coordinate				= view_projection_coordinate(position); 
		float depth 				= distance_to_view(position);		
		float scale 				= .125 * rcp(depth);

		if(in_frustrum(position))																								
		{							
			raster_circle(position, scale * 2., 512, color, _ColorTarget);	    			
		}
		raster_circle(CPU.rendering.projection.position.xyz + CPU.rendering.projection.direction.xyz * .00001, scale * 2., 512, color, _ColorTarget);	    			
		
		// raster_line(position, CPU.rendering.projection.position.xyz - CPU.rendering.projection.direction.xyz * .0001 - float3(0., .001, 0.), 512, float4(1., 1., 1., 1.), _ColorTarget);							
 
		float3 origin 									= position;
		float depth_prior	 							= 0.;
		float3 offset 									= float3(0.,0., 0.);
		float3 normal 									= float3(0.,0., 0.);
		uint halt 										= 0;
		uint v 											= 0.;
		for(int i = 0; i < limit; i++)
		{
			offset 										= normalize(spherical_fibonacci(v % limit/2, limit));

			float3x3 rotation 							= aligned_orthonormal_basis(float3(0.,1.,0.), CPU.rendering.projection.position, CPU.rendering.projection.direction, float3(1.,0.,0.)); 
			offset 										= mul(offset, rotation);
			v++;
			position 									= origin + offset * scale *  1e-7;
			depth										= distance_to_view(position);	
		
			normal 										= normalize(offset);

			if(in_frustrum(position))
			{
				coordinate								= view_projection_coordinate(position); 	

				if(in_screen(coordinate))
				{
					depth_prior							= _ColorTarget[coordinate].w;
					
					// if(depth_prior > depth)
					{							
						//raster_line(tensor.position.xyz, position, limit, float4(color, 1.), _ColorTarget);							
						
						_ColorTarget[coordinate] 	+= float4(rainbow(v * rcp(limit)), depth);	
					}
					 			
				}
			}
		
		}
	}
}
#else
[numthreads(1, 1, 1)]
void Collision(uint thread : SV_DispatchThreadID) { }
#endif


#ifdef DIAGNOSTIC_INPUT
[numthreads(THREAD_GROUP_SIZE_X, THREAD_GROUP_SIZE_Y, 1)]
void Input(uint2 thread : SV_DispatchThreadID)
{	
	uint2 resolution            	= CPU.rendering.resolution;    

	if(thread.x < resolution.x && thread.y < resolution.y)
	{
		float4 prior 				= _ColorTarget[thread];
		prior.w 					= prior.w == 0. ? 999999. : prior.w;

	    float2 aspect 				= resolution * rcp(max(resolution.x, resolution.y));
		float2 uv	 				= thread.xy * rcp(resolution);
		float3 origin 				= mul(CPU.rendering.projection.to_world, float4(0.,0.,0.,1.)).xyz;
	   	float3 direction 			= uv_to_ray(uv);
	   	
		float3 position 			= float3(0., 0., 0.);		
		
		float integral 				= 0.;
		float step_size				= .0001;
		float range 				= 0.;
		float depth 				= .0001;
		const float iterations 		= 32.;
		bool hit 					= false;
		for(float i = 0.; i < iterations; i++)
		{
			position 				= origin + direction * depth;

			range 					= map_sobel_force(position);

			if(range < .005)
			{
				hit 				= true;
				integral 			+= abs(range) * .5 + .0125;
				depth 				+= .0125;
			}
			else
			{
				depth 				+= range * .85;
			}

			if(depth >= prior.w) break;				
		}		 

		if(hit)
		{
			float4 color 				= float4(0., 0., 0., depth);
			color.xyz 					+= integral * .75;
			
			_ColorTarget[thread]		+= color;
		}			
	}
}
#else
[numthreads(1, 1, 1)]
void Input(uint2 thread : SV_DispatchThreadID) { }
#endif


#ifdef DIAGNOSTIC_BITMAP
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Bitmap(uint thread : SV_DispatchThreadID)
{			
	int2 resolution                 = CPU.rendering.resolution;
    
    int scale                       = 1;

    int2 bounds                     = floor(CPU.rendering.resolution * rcp(scale) - scale);

    int column                      = thread % bounds.y;
    int row                         = thread * rcp(bounds.y) % bounds.x;

    int2 coordinate                	= max(int2(row, column) * scale, 0.);

    if(coordinate.x < resolution.x && coordinate.y < resolution.y)
    {        
		uint2 bitmap				= load_64(thread, _Bitmap_Low);	

        float4 color                = float4(0., 0., 0., 0.);
        color.xyz					+= any(bitmap.x);
        color.xyz					+= any(bitmap.y);
        // color.xyz					+= .5;

        if(color.x > 0.)
        {
	        for(int y = 0; y < scale; y++)
	        {
	            for(int x = 0; x < scale; x++)    
	            {
	                _ColorTarget[coordinate + int2(x, y)] = clamp(_ColorTarget[coordinate + int2(x, y)] + color, 0., 1.);
	            }
	        }  
        }      
    }
}
#else
[numthreads(1, 1, 1)]
void Bitmap(uint thread : SV_DispatchThreadID) { }
#endif



#ifdef DIAGNOSTIC_MEMORY
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Memory(uint thread : SV_DispatchThreadID)
{			
	int2 resolution                 = CPU.rendering.resolution;
    
    int scale                       = 1;

    int2 bounds                     = floor(CPU.rendering.resolution * rcp(scale) - scale);

    int column                      = thread % bounds.y;
    int row                         = thread * rcp(bounds.y) % bounds.x;

    int2 coordinate                = max(int2(row, column) * scale, 0.);

    if(coordinate.x < resolution.x && coordinate.y < resolution.y)
    {        
		StructTensor tensor 		= _Tensor[thread];

        float4 color                = float4(0., 0., 0., 0.);
        color.xyz					= tensor.color.xyz;
        color.xyz					+= .0125;
        color.w						= 1.;

        // if(color.x > 0.)
        {
	        for(int y = 0; y < scale; y++)
	        {
	            for(int x = 0; x < scale; x++)    
	            {
	                _ColorTarget[coordinate + int2(x, y)] = clamp(_ColorTarget[coordinate + int2(x, y)] + color, 0., 1.);
	            }
	        }  
        }      
    }
}
#else
[numthreads(1, 1, 1)]
void Memory(uint thread : SV_DispatchThreadID) { }
#endif



